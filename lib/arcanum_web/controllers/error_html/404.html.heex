<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · Arcanum</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body>
    <Layouts.app flash={%{}} community>
      <section id="not-found" class="py-12 sm:py-20">
        <p class="text-sm font-bold tracking-widest text-blue-600">404</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight">Page not found</h1>
        <p class="mt-4 max-w-lg text-stone-600">
          This page may have moved, been removed, or never existed.
          Head back to your communities to continue the conversation.
        </p>
        <.link
          id="not-found-home"
          href={~p"/communities"}
          class="community-button mt-6 inline-flex items-center gap-2 transition-colors hover:bg-blue-700"
        >
          <.icon name="hero-arrow-left" class="size-4" /> Back to communities
        </.link>
      </section>
    </Layouts.app>
  </body>
</html>
